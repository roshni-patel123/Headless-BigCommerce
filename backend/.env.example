PORT=5111
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# BigCommerce Admin API
BIGCOMMERCE_STORE_HASH=
BIGCOMMERCE_ACCESS_TOKEN=
BIGCOMMERCE_CLIENT_ID=
BIGCOMMERCE_CHANNEL_ID=1

# Storefront API token (optional)
BIGCOMMERCE_STOREFRONT_TOKEN=

# Optional Redis (falls back to in-memory cache)
REDIS_URL=

# Engine adapter: bigcommerce
COMMERCE_ENGINE=bigcommerce

# MySQL — create DB with: npm run db:init
# Example with password: mysql://root:yourpassword@localhost:3306/velora
# Example with no password: mysql://root:@localhost:3306/velora
DATABASE_URL=mysql://root:password@localhost:3306/velora

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Required OAuth scopes (API account):
# Products, Categories, Brands (read)
# Carts, Checkouts (modify)
# Customers, Orders (modify/read)
# Create Payments (modify)
# Content (read)
# Channel Settings (read)
